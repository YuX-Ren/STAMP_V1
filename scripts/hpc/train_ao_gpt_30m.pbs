#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N ao_gpt_30m
#PBS -l walltime=72:00:00
#PBS -l select=1:ngpus=1:ncpus=16:mem=96gb

set -euo pipefail

# -----------------------------------------------------------------------------
# Paths (override via `qsub -v VAR=value,...`)
# -----------------------------------------------------------------------------
: "${REPO_ROOT:=/home/svu/yuxuan.ren/STAMP_V1.5}"
: "${CONDA_ENV:=stamp-train-rdkit-2025_09_4}"  # built from envs/stamp-train-rdkit-2025.09.4.yml + pip torch cu124
: "${PARQUET:=/scratch/yuxuan.ren/data/dataset_stamp.parquet}"
: "${STAMP_VOCAB:=/scratch/yuxuan.ren/data/v3_cm_union.txt}"
: "${CKPT_ROOT:=/scratch/yuxuan.ren/data/ckpt_stamp}"
: "${RUN_NAME:=ao_gpt_30m_d512_l8}"
: "${OUTPUT_DIR:=${CKPT_ROOT}/${RUN_NAME}}"

# -----------------------------------------------------------------------------
# Data / dataset columns
# -----------------------------------------------------------------------------
: "${TEXT_COLUMN:=stamp_smiles}"
: "${SPLIT_COLUMN:=split_random}"
: "${TRAIN_SPLIT:=train}"
: "${VALID_SPLIT:=val}"
: "${TRAIN_MAX_ROWS:=0}"          # 0 = all (~30M)
: "${VALID_MAX_ROWS:=20000}"

# -----------------------------------------------------------------------------
# Model / optim (single-GPU default, modest-size AO-GPT)
# -----------------------------------------------------------------------------
: "${D_MODEL:=512}"
: "${N_HEADS:=8}"
: "${N_LAYERS:=8}"
: "${D_FF:=2048}"
: "${DROPOUT:=0.1}"
: "${MAX_SEQ_LEN:=64}"            # data p95=20, max=39 → 64 is safe with headroom
: "${BATCH_SIZE:=4096}"           # bs=8192 OOMs: cross_entropy logits (bs*seq*vocab≈13GB bf16) + fp32 log_softmax workspace (~26GB) + gradients blow past 140GB. bs=4096 halves that.
: "${GLOBAL_BATCH_SIZE:=4096}"    # no grad accum → 1 opt step per micro step (fast)
: "${LR:=5e-4}"                   # scaled for bs=4096; linear rule → 1.2e-3 too aggressive, sqrt rule → 6e-4; 5e-4 is safe.
: "${WEIGHT_DECAY:=0.01}"
: "${EPOCHS:=3}"                  # fast iteration — 3 passes over 24M rows
: "${AMP:=bf16}"
: "${NUM_DATA_WORKERS:=8}"        # parquet streaming, match ncpus=16 / 2
: "${PREFETCH_FACTOR:=6}"
: "${TORCH_COMPILE:=0}"           # keep off unless debugged
: "${REUSE_SCAN_CACHE:=1}"
: "${NO_TQDM:=1}"

# -----------------------------------------------------------------------------
# Runtime env
# -----------------------------------------------------------------------------
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export NCCL_DEBUG=WARN

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"

cd "${REPO_ROOT}"

mkdir -p "${OUTPUT_DIR}"
LOG_DIR="${OUTPUT_DIR}/logs"
mkdir -p "${LOG_DIR}"
STAMP_TS="$(date +%Y%m%d_%H%M%S)"
LOG_FILE="${LOG_DIR}/train_${STAMP_TS}.log"

echo "[INFO] Host: $(hostname)"
echo "[INFO] Start: $(date)"
echo "[INFO] REPO_ROOT=${REPO_ROOT}"
echo "[INFO] CONDA_ENV=${CONDA_ENV}"
echo "[INFO] PARQUET=${PARQUET}"
echo "[INFO] STAMP_VOCAB=${STAMP_VOCAB}"
echo "[INFO] OUTPUT_DIR=${OUTPUT_DIR}"
echo "[INFO] Model: d=${D_MODEL} L=${N_LAYERS} H=${N_HEADS} ff=${D_FF} seq=${MAX_SEQ_LEN}"
echo "[INFO] Batch: micro=${BATCH_SIZE} global=${GLOBAL_BATCH_SIZE} epochs=${EPOCHS} amp=${AMP}"
echo "[INFO] LOG_FILE=${LOG_FILE}"

# -----------------------------------------------------------------------------
# Preflight: verify deps & GPU
# -----------------------------------------------------------------------------
python - <<'PY'
import importlib, sys
missing = []
for mod in ("torch", "pyarrow", "rdkit", "numpy", "pandas"):
    try:
        m = importlib.import_module(mod)
        print(f"[preflight] {mod}={getattr(m, '__version__', '?')}")
    except Exception as e:
        missing.append((mod, str(e)))
if missing:
    for mod, err in missing:
        print(f"[preflight][ERROR] {mod}: {err}", file=sys.stderr)
    sys.exit(1)
import torch
print(f"[preflight] cuda_available={torch.cuda.is_available()} device_count={torch.cuda.device_count()}")
if not torch.cuda.is_available():
    print("[preflight][ERROR] No CUDA device visible on this PBS job.", file=sys.stderr)
    sys.exit(2)
PY

nvidia-smi || true

# -----------------------------------------------------------------------------
# Train
# -----------------------------------------------------------------------------
ARGS=(
  scripts/benchmark/train_ao_gpt_parquet.py
  --parquet        "${PARQUET}"
  --stamp-vocab    "${STAMP_VOCAB}"
  --output-dir     "${OUTPUT_DIR}"
  --text-column    "${TEXT_COLUMN}"
  --split-column   "${SPLIT_COLUMN}"
  --train-split    "${TRAIN_SPLIT}"
  --valid-split    "${VALID_SPLIT}"
  --train-max-rows "${TRAIN_MAX_ROWS}"
  --valid-max-rows "${VALID_MAX_ROWS}"
  --epochs         "${EPOCHS}"
  --d-model        "${D_MODEL}"
  --n-heads        "${N_HEADS}"
  --n-layers       "${N_LAYERS}"
  --d-ff           "${D_FF}"
  --dropout        "${DROPOUT}"
  --max-seq-len    "${MAX_SEQ_LEN}"
  --batch-size     "${BATCH_SIZE}"
  --global-batch-size "${GLOBAL_BATCH_SIZE}"
  --lr             "${LR}"
  --weight-decay   "${WEIGHT_DECAY}"
  --amp            "${AMP}"
  --num-data-workers  "${NUM_DATA_WORKERS}"
  --prefetch-factor   "${PREFETCH_FACTOR}"
  --device cuda:0
)
[[ "${NO_TQDM}" == "1" ]]           && ARGS+=(--no-tqdm)
[[ "${REUSE_SCAN_CACHE}" == "1" ]]  && ARGS+=(--reuse-scan-cache)
if [[ "${TORCH_COMPILE}" == "1" ]]; then
  ARGS+=(--torch-compile)
else
  ARGS+=(--no-torch-compile)
fi

python "${ARGS[@]}" 2>&1 | tee "${LOG_FILE}"

echo "[INFO] End: $(date)"
echo "[INFO] Checkpoints: ${OUTPUT_DIR}/model.pt  +  ${OUTPUT_DIR}/checkpoints/epoch_*.pt"
