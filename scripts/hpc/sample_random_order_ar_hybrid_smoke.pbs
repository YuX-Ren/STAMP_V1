#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N ao_rand_ar
#PBS -l walltime=01:00:00
#PBS -l select=1:ngpus=1:ncpus=8:mem=80gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4

: "${MODEL_DIR:=/scratch/yuxuan.ren/data/ckpt_stamp/zinc_l3_full_aogpt_uncond_top12k_4g/legacy_tree}"
: "${OUT_DIR:=${MODEL_DIR}/random_order_ar_hybrid_smoke_20260604}"
: "${NUM_SAMPLES:=128}"
: "${MAX_LEN:=96}"
: "${SEED:=42}"
: "${CONFIGS:=ar,0.6,10,0;rand,0.6,10,0;rand,0.7,10,0}"

export OMP_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
cd "${REPO_ROOT}"
mkdir -p "${OUT_DIR}"

echo "[INFO] Host=$(hostname) Start=$(date)"
echo "[INFO] MODEL_DIR=${MODEL_DIR}"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] NUM_SAMPLES=${NUM_SAMPLES} MAX_LEN=${MAX_LEN} SEED=${SEED}"
echo "[INFO] CONFIGS=${CONFIGS}"
nvidia-smi --query-gpu=name,memory.free --format=csv,noheader || true

python -u scripts/benchmark/eval_random_order_ar_hybrid.py \
  --model-dir "${MODEL_DIR}" \
  --output-dir "${OUT_DIR}" \
  --num-samples "${NUM_SAMPLES}" \
  --max-len "${MAX_LEN}" \
  --seed "${SEED}" \
  --device cuda \
  --configs "${CONFIGS}"

echo "[INFO] End=$(date)"
