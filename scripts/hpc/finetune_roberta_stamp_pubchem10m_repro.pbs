#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N stamp_rob_repro
#PBS -l walltime=48:00:00
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/nfs/home/svu/yuxuan.ren/STAMP_V1.5_pp}"
CONDA_ENV="${CONDA_ENV:-stamp-train-rdkit-2025_09_4}"
CONDA_SH="${CONDA_SH:-/scratch/yuxuan.ren/miniconda3/etc/profile.d/conda.sh}"

PRETRAIN_ROOT="${PRETRAIN_ROOT:-/scratch/yuxuan.ren/data/pubchem10m}"
RUN_ROOT="${RUN_ROOT:-/scratch/yuxuan.ren/data/pubchem10m/repro_stamp_roberta_pubchem10m_$(date +%Y%m%d_%H%M%S)}"
DATA_DIR="${DATA_DIR:-/scratch/yuxuan.ren/data/moleculenet}"

VARIANTS="${VARIANTS:-pretrain_stamp_top4666 pretrain_stamp_top4666_mtr}"
TASKS="${TASKS:-bbbp hiv bace tox21 clintox sider esol freesolv lipophilicity}"

FT_BATCH_SIZE="${FT_BATCH_SIZE:-32}"
FT_LR="${FT_LR:-2e-5}"
FT_EPOCHS="${FT_EPOCHS:-20}"
FT_DROPOUT="${FT_DROPOUT:-0.1}"
SPLIT_SEED="${SPLIT_SEED:-42}"
TRAIN_SEED="${TRAIN_SEED:-42}"
ENCODE_WORKERS="${ENCODE_WORKERS:-8}"
ENCODE_CHUNKSIZE="${ENCODE_CHUNKSIZE:-128}"
NUM_DATA_WORKERS="${NUM_DATA_WORKERS:-4}"
PREFETCH_FACTOR="${PREFETCH_FACTOR:-4}"
AMP="${AMP:-auto}"
RUN_ID="${PBS_JOBID:-manual}"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"
export TOKENIZERS_PARALLELISM=false

source "${CONDA_SH}"
conda activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"

cd "${REPO_ROOT}"
mkdir -p "${RUN_ROOT}/logs"
LOG_FILE="${RUN_ROOT}/logs/repro_${RUN_ID}_$(date +%Y%m%d_%H%M%S).log"

echo "[INFO] host=$(hostname)"
echo "[INFO] job=${RUN_ID}"
echo "[INFO] repo=${REPO_ROOT}"
echo "[INFO] pretrain_root=${PRETRAIN_ROOT}"
echo "[INFO] run_root=${RUN_ROOT}"
echo "[INFO] data_dir=${DATA_DIR}"
echo "[INFO] variants=${VARIANTS}"
echo "[INFO] tasks=${TASKS}"
echo "[INFO] lr=${FT_LR} batch=${FT_BATCH_SIZE} epochs=${FT_EPOCHS} dropout=${FT_DROPOUT}"
echo "[INFO] split_seed=${SPLIT_SEED} train_seed=${TRAIN_SEED} amp=${AMP}"
nvidia-smi || true

for variant in ${VARIANTS}; do
  pt_dir="${PRETRAIN_ROOT}/${variant}"
  if [ ! -f "${pt_dir}/pretrained_roberta.pt" ]; then
    echo "[SKIP] missing ${pt_dir}/pretrained_roberta.pt" | tee -a "${LOG_FILE}"
    continue
  fi

  for task in ${TASKS}; do
    out_dir="${RUN_ROOT}/${variant}/${task}"
    if [ -f "${out_dir}/finetune_results.json" ]; then
      echo "[SKIP] ${variant}/${task} already done" | tee -a "${LOG_FILE}"
      continue
    fi
    mkdir -p "${out_dir}"
    echo "========== ${variant} / ${task} start $(date) ==========" | tee -a "${LOG_FILE}"
    python scripts/experiments_cli.py finetune-roberta \
      --pretrained-dir "${pt_dir}" \
      --task "${task}" \
      --data-dir "${DATA_DIR}" \
      --output-dir "${out_dir}" \
      --split-seed "${SPLIT_SEED}" \
      --train-seed "${TRAIN_SEED}" \
      --finetune-epochs "${FT_EPOCHS}" \
      --finetune-lr "${FT_LR}" \
      --finetune-batch-size "${FT_BATCH_SIZE}" \
      --dropout "${FT_DROPOUT}" \
      --encode-workers "${ENCODE_WORKERS}" \
      --encode-chunksize "${ENCODE_CHUNKSIZE}" \
      --num-data-workers "${NUM_DATA_WORKERS}" \
      --prefetch-factor "${PREFETCH_FACTOR}" \
      --amp "${AMP}" \
      --device cuda \
      2>&1 | tee "${out_dir}/finetune.log" | tee -a "${LOG_FILE}"
    echo "========== ${variant} / ${task} done $(date) ==========" | tee -a "${LOG_FILE}"
  done
done

python - <<PY | tee -a "${LOG_FILE}"
import csv
import json
from pathlib import Path

root = Path("${RUN_ROOT}")
variants = "${VARIANTS}".split()
tasks = "${TASKS}".split()
rows = []
for variant in variants:
    row = {"variant": variant}
    for task in tasks:
        p = root / variant / task / "finetune_results.json"
        if not p.exists():
            row[task] = "MISSING"
            continue
        d = json.loads(p.read_text())
        row[task] = d.get("test_roc_auc", d.get("test_rmse", "NA"))
    rows.append(row)

out = root / "summary.csv"
with out.open("w", newline="") as f:
    writer = csv.DictWriter(f, fieldnames=["variant"] + tasks)
    writer.writeheader()
    writer.writerows(rows)

print(f"[done] {out}")
for row in rows:
    print(row)
PY

echo "[INFO] finished $(date)"
