#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N many_to_one_single
#PBS -l walltime=02:00:00
#PBS -l select=1:ngpus=1:ncpus=8:mem=120gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4

: "${CHECKPOINT:?Set CHECKPOINT=/path/to/model.pt-or-step.pt}"
: "${MODEL_DIR:?Set MODEL_DIR=/path/to/legacy_tree}"
: "${OUTPUT:?Set OUTPUT=/path/to/output.json}"
: "${NUM_SAMPLES:=2048}"
: "${BATCH_SIZE:=256}"
: "${TEMPERATURE:=0.7}"
: "${TOP_K:=0}"
: "${TOP_P:=0.95}"
: "${MAX_NEW:=127}"
: "${SEED:=123}"

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
cd "${REPO_ROOT}"

echo "[many-to-one-single] host=$(hostname) start=$(date)"
echo "[many-to-one-single] checkpoint=${CHECKPOINT}"
echo "[many-to-one-single] model_dir=${MODEL_DIR}"
echo "[many-to-one-single] output=${OUTPUT}"
nvidia-smi --query-gpu=name,memory.free --format=csv,noheader || true

python -u scripts/benchmark/analyze_generation_many_to_one.py \
  --checkpoint "${CHECKPOINT}" \
  --model-dir "${MODEL_DIR}" \
  --output "${OUTPUT}" \
  --num-samples "${NUM_SAMPLES}" \
  --batch-size "${BATCH_SIZE}" \
  --temperature "${TEMPERATURE}" \
  --top-k "${TOP_K}" \
  --top-p "${TOP_P}" \
  --max-new "${MAX_NEW}" \
  --seed "${SEED}" \
  --device cuda

echo "[many-to-one-single] done $(date)"
