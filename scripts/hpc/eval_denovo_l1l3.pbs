#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N eval_denovo_l3
#PBS -l walltime=01:00:00
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb

set -euo pipefail

REPO_ROOT=/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4
# Use ep14 (best val) by default; override via -v MODEL_DIR=...
: "${MODEL_DIR:=/scratch/yuxuan.ren/data/ckpt_stamp/ao_l1_l3_30m/legacy_tree_ep14}"
: "${OUT_DIR:=/scratch/yuxuan.ren/data/ckpt_stamp/ao_l1_l3_30m/eval_denovo}"
: "${NUM_SAMPLES:=1000}"
: "${TEMP:=1.0}"
: "${TOPK:=0}"
: "${TOPP:=0.95}"
: "${DEDUP_FILL:=1}"
: "${OVERSAMPLE_FACTOR:=3.0}"

export OMP_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
cd "${REPO_ROOT}"
mkdir -p "${OUT_DIR}"

echo "[INFO] Host=$(hostname) Start=$(date)"
nvidia-smi --query-gpu=name,memory.free --format=csv,noheader || true
echo "[INFO] MODEL_DIR=${MODEL_DIR}"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] NUM_SAMPLES=${NUM_SAMPLES} TEMP=${TEMP} TOPK=${TOPK} TOPP=${TOPP}"
echo "[INFO] DEDUP_FILL=${DEDUP_FILL} OVERSAMPLE_FACTOR=${OVERSAMPLE_FACTOR}"

DEDUP_ARGS=()
if [[ "${DEDUP_FILL}" == "1" ]]; then
  DEDUP_ARGS=(--dedup-fill --oversample-factor "${OVERSAMPLE_FACTOR}")
fi

python -u scripts/benchmark/eval_denovo_taskaware.py \
  --model-dir "${MODEL_DIR}" \
  --output-dir "${OUT_DIR}" \
  --num-samples "${NUM_SAMPLES}" \
  --batch-size 200 \
  --temperature "${TEMP}" \
  --top-k "${TOPK}" \
  --top-p "${TOPP}" \
  --max-new 80 \
  --device cuda \
  --seed 0 \
  "${DEDUP_ARGS[@]}" 2>&1 | tee "${OUT_DIR}/eval.log"

echo "[INFO] End=$(date)"
