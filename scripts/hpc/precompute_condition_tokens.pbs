#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N precomp_cond
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=32:mem=128gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4

: "${STAMP_PARQUET:=/Project_Storage/CFP-03/CFP03-CF-130/data/zinc_pretrain/output/*_stamp.parquet}"
: "${OUT_DIR:=/scratch/yuxuan.ren/data/zinc_pretrain/output_condition_qedsa}"
: "${SMILES_COLUMN:=smiles}"
: "${CONDITION_MODE:=qed_sa}"
: "${MAX_FILES:=0}"
: "${MAX_ROWS_PER_FILE:=0}"
: "${OVERWRITE:=0}"

export OMP_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
cd "${REPO_ROOT}"
mkdir -p "${OUT_DIR}"

echo "[INFO] Host=$(hostname) Start=$(date)"
echo "[INFO] STAMP_PARQUET=${STAMP_PARQUET}"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] CONDITION_MODE=${CONDITION_MODE} SMILES_COLUMN=${SMILES_COLUMN}"
echo "[INFO] MAX_FILES=${MAX_FILES} MAX_ROWS_PER_FILE=${MAX_ROWS_PER_FILE} OVERWRITE=${OVERWRITE}"
python -V

OVERWRITE_ARGS=()
if [[ "${OVERWRITE}" == "1" ]]; then
  OVERWRITE_ARGS=(--overwrite)
fi

python -u scripts/benchmark/precompute_condition_tokens.py \
  --parquet "${STAMP_PARQUET}" \
  --output-dir "${OUT_DIR}" \
  --smiles-column "${SMILES_COLUMN}" \
  --condition-mode "${CONDITION_MODE}" \
  --max-files "${MAX_FILES}" \
  --max-rows-per-file "${MAX_ROWS_PER_FILE}" \
  "${OVERWRITE_ARGS[@]}" 2>&1 | tee "${OUT_DIR}/precompute_condition_tokens.log"

echo "[INFO] End=$(date)"
