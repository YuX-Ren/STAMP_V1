#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N molf_s20k_ft
#PBS -l walltime=48:00:00
#PBS -l select=1:ngpus=1:ncpus=16:mem=128gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5_pp
CONDA_ENV="${CONDA_ENV:-stamp-train-rdkit-2025_09_4}"
CONDA_SH="${CONDA_SH:-/scratch/yuxuan.ren/miniconda3/etc/profile.d/conda.sh}"

# MoleculeNet downstream uses only the coarsest STAMP scale. The smaller
# msring scales are for pretraining views, not for property-prediction inputs.
PRETRAIN_DIR="${PRETRAIN_DIR:-/scratch/yuxuan.ren/data/ckpt_stamp/molformer_stamp_msring_s20000_fastmlm_b512g4096_w12}"
CHECKPOINT="${CHECKPOINT:-${PRETRAIN_DIR}/best_valid.pt}"
DATA_DIR="${DATA_DIR:-/scratch/yuxuan.ren/data/moleculenet}"
STAMP_VOCAB="${STAMP_VOCAB:-/scratch/yuxuan.ren/data/molformer_encoded_msring/vocab/multiscale_ring_augmented/vocab_s20000_plus_atoms.txt}"

TASK_GROUP="${TASK_GROUP:-all}"
case "${TASK_GROUP}" in
  small_cls)
    DEFAULT_TASKS="bbbp,bace,clintox,sider"
    ;;
  large_cls)
    DEFAULT_TASKS="hiv,tox21"
    ;;
  reg)
    DEFAULT_TASKS="esol,freesolv,lipophilicity"
    ;;
  all)
    DEFAULT_TASKS="bbbp,hiv,bace,clintox,tox21,sider,esol,freesolv,lipophilicity"
    ;;
  *)
    DEFAULT_TASKS="${TASK_GROUP}"
    ;;
esac

TASKS="${TASKS:-${DEFAULT_TASKS}}"
TARGET_MODE="${TARGET_MODE:-paper}"
OUT_BASE="${OUT_BASE:-/scratch/yuxuan.ren/data/ckpt_stamp/molformer_stamp_msring_s20000_fastmlm_moleculenet_ft_paper_targets_molformer_aligned}"
OUT_DIR="${OUT_DIR:-${OUT_BASE}/${TASK_GROUP}}"
MAX_SEQ_LEN="${MAX_SEQ_LEN:-512}"
EPOCHS="${EPOCHS:-500}"
BATCH_SIZE="${BATCH_SIZE:-128}"
LR="${LR:-3e-5}"
PATIENCE="${PATIENCE:-50}"
AMP="${AMP:-none}"
OPTIMIZER="${OPTIMIZER:-lamb}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.0}"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

source "${CONDA_SH}"
conda activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"

cd "${REPO_ROOT}"

if [ ! -f "${CHECKPOINT}" ]; then
  echo "ERROR: missing checkpoint: ${CHECKPOINT}" >&2
  echo "Set CHECKPOINT=/path/to/last.pt for the matching msring MolFormer pretrain." >&2
  exit 2
fi
if [ ! -d "${DATA_DIR}" ]; then
  echo "ERROR: missing MoleculeNet data dir: ${DATA_DIR}" >&2
  exit 2
fi
if [ ! -f "${STAMP_VOCAB}" ]; then
  echo "ERROR: missing s20000 downstream vocab: ${STAMP_VOCAB}" >&2
  exit 2
fi

mkdir -p "${OUT_DIR}/logs"
LOG_FILE="${OUT_DIR}/logs/finetune_${PBS_JOBID:-manual}_$(date +%Y%m%d_%H%M%S).log"

echo "[INFO] host=$(hostname)"
echo "[INFO] job=${PBS_JOBID:-manual}"
echo "[INFO] checkpoint=${CHECKPOINT}"
echo "[INFO] data=${DATA_DIR}"
echo "[INFO] vocab=${STAMP_VOCAB}"
echo "[INFO] task_group=${TASK_GROUP}"
echo "[INFO] tasks=${TASKS}"
echo "[INFO] target_mode=${TARGET_MODE}"
echo "[INFO] out=${OUT_DIR}"
nvidia-smi || true

python scripts/benchmark/finetune_molformer_stamp_pp.py \
  --checkpoint "${CHECKPOINT}" \
  --output-dir "${OUT_DIR}" \
  --data-dir "${DATA_DIR}" \
  --tasks "${TASKS}" \
  --stamp-vocab "${STAMP_VOCAB}" \
  --force-ring-aware-encode \
  --no-strict-vocab \
  --fallback-oov-to-smiles \
  --split-mode scaffold \
  --target-mode "${TARGET_MODE}" \
  --max-seq-len "${MAX_SEQ_LEN}" \
  --epochs "${EPOCHS}" \
  --lr "${LR}" \
  --batch-size "${BATCH_SIZE}" \
  --dropout 0.1 \
  --patience "${PATIENCE}" \
  --pooling avg \
  --optimizer "${OPTIMIZER}" \
  --weight-decay "${WEIGHT_DECAY}" \
  --amp "${AMP}" \
  --device cuda \
  --seed 42 \
  2>&1 | tee -a "${LOG_FILE}"
