#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N molt5_c4_zinc
#PBS -l walltime=72:00:00
#PBS -l select=1:ngpus=4:ncpus=32:mem=450gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4

: "${C4_TRAIN_GLOB:=/scratch/Projects/CFP-03/CFP03-CF-130/yuxuan.ren/data/c4/en/c4-train.*.json.gz}"
: "${C4_VALID_GLOB:=/scratch/Projects/CFP-03/CFP03-CF-130/yuxuan.ren/data/c4/en/c4-validation.*.json.gz}"
: "${C4_STREAMING:=0}"
: "${C4_DATASET_NAME:=allenai/c4}"
: "${C4_CONFIG_NAME:=en}"
: "${C4_TRAIN_SPLIT:=train}"
: "${C4_VALID_SPLIT:=validation}"
: "${C4_STREAM_SHUFFLE_BUFFER:=10000}"
: "${ZINC_TRAIN_PARQUET:=/scratch/Projects/CFP-03/CFP03-CF-130/yuxuan.ren/data/molformer_encoded_msring/zinc15/*.parquet}"
: "${ZINC_VALID_PARQUET:=/scratch/Projects/CFP-03/CFP03-CF-130/yuxuan.ren/data/molformer_encoded_msring/zinc15/*.parquet}"
: "${ZINC_COLUMN:=stamp}"
: "${MOLECULE_FORMAT:=stamp}"
: "${STAMP_VOCAB:=/scratch/yuxuan.ren/zinc_pretrain/vocab_merged/motif_vocab.txt}"
: "${STAMP_TOKEN_LIMIT:=12000}"
: "${STAMP_STRUCTURAL_MAX_INDEX:=255}"
: "${OUT_DIR:=/scratch/Projects/CFP-03/CFP03-CF-130/yuxuan.ren/ckpt/molt5_c4_zinc100m_stamp_top12k_bs512_t5v11base_4g_$(date +%Y%m%d_%H%M%S)}"
: "${TOKENIZER:=/scratch/yuxuan.ren/models/t5-v1_1-base}"
: "${INIT_MODEL:=/scratch/yuxuan.ren/models/t5-v1_1-base}"

: "${NPROC_PER_NODE:=4}"
: "${MAX_SOURCE_LEN:=512}"
: "${MAX_TARGET_LEN:=128}"
: "${BATCH_SIZE:=128}"
: "${GLOBAL_BATCH_SIZE:=512}"
: "${MAX_STEPS:=500000}"
: "${LR:=1e-4}"
: "${WARMUP_STEPS:=5000}"
: "${SAVE_EVERY_STEPS:=1000}"
: "${EVAL_EVERY_STEPS:=10000}"
: "${EVAL_MAX_BATCHES:=100}"
: "${C4_TRAIN_MAX_ROWS:=0}"
: "${ZINC_TRAIN_MAX_ROWS:=100000000}"
: "${C4_VALID_MAX_ROWS:=20000}"
: "${ZINC_VALID_MAX_ROWS:=20000}"
: "${NUM_DATA_WORKERS:=4}"
: "${AMP:=bf16}"
: "${RESUME_FROM:=}"

export OMP_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
cd "${REPO_ROOT}"
mkdir -p "${OUT_DIR}"

if ! compgen -G "${ZINC_TRAIN_PARQUET}" >/dev/null; then
  echo "[WARN] ZINC_TRAIN_PARQUET did not match files; falling back to /scratch/yuxuan.ren/data/molformer_encoded_msring/zinc15/*.parquet"
  ZINC_TRAIN_PARQUET="/scratch/yuxuan.ren/data/molformer_encoded_msring/zinc15/*.parquet"
fi
if ! compgen -G "${ZINC_VALID_PARQUET}" >/dev/null; then
  echo "[WARN] ZINC_VALID_PARQUET did not match files; falling back to /scratch/yuxuan.ren/data/molformer_encoded_msring/zinc15/*.parquet"
  ZINC_VALID_PARQUET="/scratch/yuxuan.ren/data/molformer_encoded_msring/zinc15/*.parquet"
fi
if [[ ! -f "${STAMP_VOCAB}" ]]; then
  echo "[ERROR] STAMP_VOCAB not found: ${STAMP_VOCAB}" >&2
  exit 2
fi

echo "[INFO] Host=$(hostname) Start=$(date)"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] C4_STREAMING=${C4_STREAMING}"
echo "[INFO] C4_TRAIN_GLOB=${C4_TRAIN_GLOB}"
echo "[INFO] C4_DATASET_NAME=${C4_DATASET_NAME} C4_CONFIG_NAME=${C4_CONFIG_NAME}"
echo "[INFO] ZINC_TRAIN_PARQUET=${ZINC_TRAIN_PARQUET}"
echo "[INFO] ZINC_COLUMN=${ZINC_COLUMN} MOLECULE_FORMAT=${MOLECULE_FORMAT}"
echo "[INFO] STAMP_VOCAB=${STAMP_VOCAB}"
echo "[INFO] ZINC_TRAIN_MAX_ROWS=${ZINC_TRAIN_MAX_ROWS}"
echo "[INFO] NPROC_PER_NODE=${NPROC_PER_NODE} BATCH_SIZE=${BATCH_SIZE} GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE}"
echo "[INFO] MAX_STEPS=${MAX_STEPS} SAVE_EVERY_STEPS=${SAVE_EVERY_STEPS} EVAL_EVERY_STEPS=${EVAL_EVERY_STEPS}"
nvidia-smi --query-gpu=name,memory.free --format=csv,noheader || true

RESUME_ARGS=()
if [[ -n "${RESUME_FROM}" ]]; then
  RESUME_ARGS=(--resume-from "${RESUME_FROM}")
fi

C4_ARGS=(--c4-train-glob "${C4_TRAIN_GLOB}" --c4-valid-glob "${C4_VALID_GLOB}")
if [[ "${C4_STREAMING}" == "1" || "${C4_STREAMING}" == "true" || "${C4_STREAMING}" == "TRUE" ]]; then
  C4_ARGS=(
    --c4-streaming
    --c4-dataset-name "${C4_DATASET_NAME}"
    --c4-config-name "${C4_CONFIG_NAME}"
    --c4-train-split "${C4_TRAIN_SPLIT}"
    --c4-valid-split "${C4_VALID_SPLIT}"
    --c4-stream-shuffle-buffer "${C4_STREAM_SHUFFLE_BUFFER}"
  )
fi

torchrun --standalone --nnodes=1 --nproc_per_node="${NPROC_PER_NODE}" \
  scripts/benchmark/train_molt5_c4_zinc_mixed.py \
  "${C4_ARGS[@]}" \
  --zinc-train-parquet "${ZINC_TRAIN_PARQUET}" \
  --zinc-valid-parquet "${ZINC_VALID_PARQUET}" \
  --zinc-column "${ZINC_COLUMN}" \
  --molecule-format "${MOLECULE_FORMAT}" \
  --stamp-vocab "${STAMP_VOCAB}" \
  --stamp-token-limit "${STAMP_TOKEN_LIMIT}" \
  --stamp-structural-max-index "${STAMP_STRUCTURAL_MAX_INDEX}" \
  --output-dir "${OUT_DIR}" \
  --tokenizer "${TOKENIZER}" \
  --init-model "${INIT_MODEL}" \
  --max-source-len "${MAX_SOURCE_LEN}" \
  --max-target-len "${MAX_TARGET_LEN}" \
  --noise-density 0.15 \
  --mean-noise-span-length 3.0 \
  --batch-size "${BATCH_SIZE}" \
  --global-batch-size "${GLOBAL_BATCH_SIZE}" \
  --max-steps "${MAX_STEPS}" \
  --lr "${LR}" \
  --warmup-steps "${WARMUP_STEPS}" \
  --save-every-steps "${SAVE_EVERY_STEPS}" \
  --eval-every-steps "${EVAL_EVERY_STEPS}" \
  --eval-max-batches "${EVAL_MAX_BATCHES}" \
  --c4-train-max-rows "${C4_TRAIN_MAX_ROWS}" \
  --zinc-train-max-rows "${ZINC_TRAIN_MAX_ROWS}" \
  --c4-valid-max-rows "${C4_VALID_MAX_ROWS}" \
  --zinc-valid-max-rows "${ZINC_VALID_MAX_ROWS}" \
  --num-data-workers "${NUM_DATA_WORKERS}" \
  --amp "${AMP}" \
  "${RESUME_ARGS[@]}" 2>&1 | tee "${OUT_DIR}/train.log"

echo "[INFO] End=$(date)"
