set -euo pipefail

cd /nfs/home/svu/yuxuan.ren/STAMP_V1.5_pp

export DATA_DIR="${DATA_DIR:-/Project_Storage/CFP-03/CFP03-CF-130/data/zinc_pretrain/output_multiscale}"
export VOCAB_DIR="${VOCAB_DIR:-/Project_Storage/CFP-03/CFP03-CF-130/data/zinc_pretrain/vocab_merged}"
