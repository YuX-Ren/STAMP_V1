#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N cams_msring3
#PBS -l walltime=96:00:00
#PBS -l select=1:ngpus=4:ncpus=48:mem=512gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5_pp
CONDA_ENV="${CONDA_ENV:-stamp-train-rdkit-2025_09_4}"
CONDA_SH="${CONDA_SH:-/scratch/yuxuan.ren/miniconda3/etc/profile.d/conda.sh}"

DATA_ROOT="${DATA_ROOT:-/scratch/yuxuan.ren/data/molformer_encoded_msring}"
PUBCHEM_DIR="${PUBCHEM_DIR:-${DATA_ROOT}/pubchem}"
ZINC15_DIR="${ZINC15_DIR:-${DATA_ROOT}/zinc15}"
VOCAB_DIR="${VOCAB_DIR:-${DATA_ROOT}/vocab/multiscale_ring_augmented}"
OUT_DIR="${OUT_DIR:-/scratch/yuxuan.ren/data/ckpt_stamp/cams_stamp_decoder_msring_3s_pubchem_zinc15_smilesfb}"

NPROC_PER_NODE="${NPROC_PER_NODE:-4}"
BATCH_SIZE="${BATCH_SIZE:-64}"
GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-4096}"
MAX_SEQ_LEN="${MAX_SEQ_LEN:-512}"
EPOCHS="${EPOCHS:-1}"
MAX_OPTIMIZER_STEPS="${MAX_OPTIMIZER_STEPS:-50000}"
SAVE_EVERY_STEPS="${SAVE_EVERY_STEPS:-1000}"
RESUME_FROM="${RESUME_FROM:-}"
LENGTH_BUCKET_SIZE="${LENGTH_BUCKET_SIZE:-8}"
VALID_MAX_ROWS="${VALID_MAX_ROWS:-50000}"
SCAN_TRAIN_MAX_ROWS="${SCAN_TRAIN_MAX_ROWS:-500000}"
SCAN_VALID_MAX_ROWS="${SCAN_VALID_MAX_ROWS:-50000}"
NUM_DATA_WORKERS="${NUM_DATA_WORKERS:-6}"
PREFETCH_FACTOR="${PREFETCH_FACTOR:-2}"
AMP="${AMP:-fp16}"
DEVICE="${DEVICE:-cuda}"
SEED="${SEED:-42}"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"

source "${CONDA_SH}"
set +e
conda activate "${CONDA_ENV}"
ACTIVATE_RC=$?
set -e
if [ "${ACTIVATE_RC}" -ne 0 ]; then
  echo "[WARN] conda activate returned ${ACTIVATE_RC}; retrying after clearing active env vars" >&2
  unset CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL
  conda activate "${CONDA_ENV}"
fi
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"

cd "${REPO_ROOT}"

for dir in "${PUBCHEM_DIR}" "${ZINC15_DIR}"; do
  if [ ! -d "${dir}" ]; then
    echo "ERROR: data directory missing: ${dir}" >&2
    exit 2
  fi
done

STAMP_VOCAB="${VOCAB_DIR}/vocab_s20000_plus_atoms.txt"
MULTISCALE_VOCABS="${VOCAB_DIR}/vocab_s800_plus_atoms.txt,${VOCAB_DIR}/vocab_s2000_plus_atoms.txt,${VOCAB_DIR}/vocab_s20000_plus_atoms.txt"
for vocab in "${VOCAB_DIR}/vocab_s800_plus_atoms.txt" "${VOCAB_DIR}/vocab_s2000_plus_atoms.txt" "${VOCAB_DIR}/vocab_s20000_plus_atoms.txt"; do
  if [ ! -f "${vocab}" ]; then
    echo "ERROR: vocab missing: ${vocab}" >&2
    exit 2
  fi
done

RUN_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
MANIFEST_DIR="${OUT_DIR}/manifests/${RUN_ID}"
TRAIN_DIR="${MANIFEST_DIR}/train"
VALID_DIR="${MANIFEST_DIR}/valid"
mkdir -p "${TRAIN_DIR}" "${VALID_DIR}" "${OUT_DIR}/logs"

link_pubchem_shards() {
  local src b idx idx10 dest
  for src in "${PUBCHEM_DIR}"/shard_*_msring.parquet; do
    [ -e "${src}" ] || continue
    b="$(basename "${src}")"
    idx="${b#shard_}"
    idx="${idx%_msring.parquet}"
    idx10=$((10#${idx}))
    if [ "${idx10}" -ge 54 ]; then
      dest="${VALID_DIR}/pubchem_${b}"
    else
      dest="${TRAIN_DIR}/pubchem_${b}"
    fi
    ln -sf "${src}" "${dest}"
  done
}

link_zinc15_shards() {
  local src b idx idx10 dest
  for src in "${ZINC15_DIR}"/shard_*_msring.parquet; do
    [ -e "${src}" ] || continue
    b="$(basename "${src}")"
    idx="${b#shard_}"
    idx="${idx%_msring.parquet}"
    idx10=$((10#${idx}))
    if [ "${idx10}" -ge 490 ]; then
      dest="${VALID_DIR}/zinc15_${b}"
    else
      dest="${TRAIN_DIR}/zinc15_${b}"
    fi
    ln -sf "${src}" "${dest}"
  done
}

link_pubchem_shards
link_zinc15_shards

TRAIN_COUNT="$(find "${TRAIN_DIR}" -maxdepth 1 -name '*.parquet' | wc -l)"
VALID_COUNT="$(find "${VALID_DIR}" -maxdepth 1 -name '*.parquet' | wc -l)"
if [ "${TRAIN_COUNT}" -eq 0 ] || [ "${VALID_COUNT}" -eq 0 ]; then
  echo "ERROR: bad train/valid manifest counts: train=${TRAIN_COUNT} valid=${VALID_COUNT}" >&2
  exit 2
fi

LOG_FILE="${OUT_DIR}/logs/train_${RUN_ID}_$(date +%Y%m%d_%H%M%S).log"

echo "[INFO] host=$(hostname)"
echo "[INFO] job=${RUN_ID}"
echo "[INFO] train_manifest=${TRAIN_DIR} count=${TRAIN_COUNT}"
echo "[INFO] valid_manifest=${VALID_DIR} count=${VALID_COUNT}"
echo "[INFO] vocab=${MULTISCALE_VOCABS}"
echo "[INFO] out=${OUT_DIR}"
echo "[INFO] model=CaMS-style decoder STAMP scales=s800,s2000,s20000"
echo "[INFO] nproc=${NPROC_PER_NODE} batch_per_rank=${BATCH_SIZE} global_batch=${GLOBAL_BATCH_SIZE} max_seq_len=${MAX_SEQ_LEN}"
if [ -n "${RESUME_FROM}" ]; then
  echo "[INFO] resume_from=${RESUME_FROM}"
fi
nvidia-smi || true

ARGS=(
  --standalone --nnodes=1 --nproc_per_node="${NPROC_PER_NODE}"
  scripts/benchmark/train_cams_decoder_shards.py \
  --train-glob "${TRAIN_DIR}/*.parquet" \
  --valid-glob "${VALID_DIR}/*.parquet" \
  --stamp-vocab "${STAMP_VOCAB}" \
  --output-dir "${OUT_DIR}" \
  --text-column stamp \
  --multiscale-vocabs "${MULTISCALE_VOCABS}" \
  --multiscale-scale-names s800,s2000,s20000 \
  --train-view-mode cams_multiview \
  --valid-view-mode concat_only \
  --expected-single-scale-views 3 \
  --loss-skip-special-tokens \
  --backbone llama \
  --d-model 720 \
  --n-heads 8 \
  --n-layers 16 \
  --d-ff 2880 \
  --dropout 0.0 \
  --max-seq-len "${MAX_SEQ_LEN}" \
  --batch-size "${BATCH_SIZE}" \
  --global-batch-size "${GLOBAL_BATCH_SIZE}" \
  --lr 3e-4 \
  --min-lr 0.0 \
  --weight-decay 0.01 \
  --lr-scheduler cosine \
  --warmup-steps 5000 \
  --epochs "${EPOCHS}" \
  --max-optimizer-steps "${MAX_OPTIMIZER_STEPS}" \
  --train-max-rows 0 \
  --length-bucket-size "${LENGTH_BUCKET_SIZE}" \
  --valid-max-rows "${VALID_MAX_ROWS}" \
  --scan-train-max-rows "${SCAN_TRAIN_MAX_ROWS}" \
  --scan-valid-max-rows "${SCAN_VALID_MAX_ROWS}" \
  --structural-max-index 512 \
  --include-smiles-fallback-tokens \
  --seed "${SEED}" \
  --num-data-workers "${NUM_DATA_WORKERS}" \
  --prefetch-factor "${PREFETCH_FACTOR}" \
  --amp "${AMP}" \
  --device "${DEVICE}" \
  --no-torch-compile \
  --save-every-steps "${SAVE_EVERY_STEPS}" \
  --reuse-scan-cache \
)
if [ -n "${RESUME_FROM}" ]; then
  ARGS+=(--resume-from "${RESUME_FROM}")
fi

torchrun "${ARGS[@]}" 2>&1 | tee -a "${LOG_FILE}"
