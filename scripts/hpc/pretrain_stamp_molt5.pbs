#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N stamp_molt5
#PBS -l walltime=48:00:00
#PBS -l select=1:ngpus=4:ncpus=32:mem=450gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4

: "${TRAIN_PARQUET:=/scratch/yuxuan.ren/data/zinc_l3_full_condition/train_*_stamp.parquet}"
: "${VALID_PARQUET:=/scratch/yuxuan.ren/data/zinc_l3_full_condition/val_*_stamp.parquet}"
: "${OUT_DIR:=/scratch/yuxuan.ren/data/ckpt_stamp/stamp_molt5_l3_full_top12k_base_4g_20260619}"
: "${TEXT_COLUMN:=stamp}"
: "${STAMP_VOCAB:=${REPO_ROOT}/data/vocab_merged/motif_vocab.txt}"
: "${MOTIF_FREQ:=${REPO_ROOT}/data/vocab_merged/zinc_plus_augment_full_freq.txt}"

: "${NPROC_PER_NODE:=4}"
: "${D_MODEL:=768}"
: "${N_HEADS:=12}"
: "${NUM_LAYERS:=12}"
: "${NUM_DECODER_LAYERS:=12}"
: "${D_FF:=3072}"
: "${MAX_SOURCE_LEN:=256}"
: "${MAX_TARGET_LEN:=128}"
: "${BATCH_SIZE:=64}"
: "${GLOBAL_BATCH_SIZE:=1024}"
: "${MAX_STEPS:=200000}"
: "${LR:=1e-4}"
: "${WARMUP_STEPS:=5000}"
: "${SAVE_EVERY_STEPS:=10000}"
: "${EVAL_EVERY_STEPS:=5000}"
: "${VALID_MAX_ROWS:=20000}"
: "${EVAL_BATCH_SIZE:=64}"
: "${NUM_DATA_WORKERS:=4}"
: "${AMP:=bf16}"
: "${RESUME_FROM:=}"

export OMP_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
cd "${REPO_ROOT}"
mkdir -p "${OUT_DIR}"

echo "[INFO] Host=$(hostname) Start=$(date)"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] TRAIN_PARQUET=${TRAIN_PARQUET}"
echo "[INFO] VALID_PARQUET=${VALID_PARQUET}"
echo "[INFO] NPROC_PER_NODE=${NPROC_PER_NODE} BATCH_SIZE=${BATCH_SIZE} GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE}"
echo "[INFO] MAX_STEPS=${MAX_STEPS} SAVE_EVERY_STEPS=${SAVE_EVERY_STEPS} EVAL_EVERY_STEPS=${EVAL_EVERY_STEPS}"
nvidia-smi --query-gpu=name,memory.free --format=csv,noheader || true

RESUME_ARGS=()
if [[ -n "${RESUME_FROM}" ]]; then
  RESUME_ARGS=(--resume-from "${RESUME_FROM}")
fi

torchrun --standalone --nnodes=1 --nproc_per_node="${NPROC_PER_NODE}" \
  scripts/benchmark/train_stamp_molt5_parquet.py \
  --train-parquet "${TRAIN_PARQUET}" \
  --valid-parquet "${VALID_PARQUET}" \
  --output-dir "${OUT_DIR}" \
  --text-column "${TEXT_COLUMN}" \
  --stamp-vocab "${STAMP_VOCAB}" \
  --motif-frequency-file "${MOTIF_FREQ}" \
  --freq-cutoff 5000 \
  --max-atomic-motifs 12000 \
  --d-model "${D_MODEL}" \
  --n-heads "${N_HEADS}" \
  --num-layers "${NUM_LAYERS}" \
  --num-decoder-layers "${NUM_DECODER_LAYERS}" \
  --d-ff "${D_FF}" \
  --max-source-len "${MAX_SOURCE_LEN}" \
  --max-target-len "${MAX_TARGET_LEN}" \
  --noise-density 0.15 \
  --mean-noise-span-length 3.0 \
  --batch-size "${BATCH_SIZE}" \
  --global-batch-size "${GLOBAL_BATCH_SIZE}" \
  --max-steps "${MAX_STEPS}" \
  --lr "${LR}" \
  --warmup-steps "${WARMUP_STEPS}" \
  --save-every-steps "${SAVE_EVERY_STEPS}" \
  --eval-every-steps "${EVAL_EVERY_STEPS}" \
  --valid-max-rows "${VALID_MAX_ROWS}" \
  --eval-batch-size "${EVAL_BATCH_SIZE}" \
  --num-data-workers "${NUM_DATA_WORKERS}" \
  --amp "${AMP}" \
  "${RESUME_ARGS[@]}" 2>&1 | tee "${OUT_DIR}/train.log"

echo "[INFO] End=$(date)"
