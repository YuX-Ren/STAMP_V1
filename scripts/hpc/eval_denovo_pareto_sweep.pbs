#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N denovo_pareto
#PBS -l walltime=04:00:00
#PBS -l select=1:ngpus=1:ncpus=8:mem=96gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4

: "${MODEL_DIR:=/scratch/yuxuan.ren/data/ckpt_stamp/zinc_l3_full_aogpt_uncond_top12k_4g_rerun_20260604/legacy_tree}"
: "${OUT_DIR:=/nfs/home/svu/yuxuan.ren/STAMP_V1.5/results/denovo_pareto_20260617}"
: "${NUM_SAMPLES:=1024}"
: "${BATCH_SIZE:=128}"
: "${MAX_NEW:=255}"
: "${SEEDS:=20260617}"
: "${TEMPERATURES:=0.5 0.6 0.7 0.8 0.9 1.0 1.1 1.2}"
: "${TOP_PS:=0.90 0.95 0.98 1.0}"
: "${TOP_KS:=0}"

export OMP_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR=/tmp/matplotlib-${PBS_JOBID:-denovo_pareto}

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
cd "${REPO_ROOT}"
mkdir -p "${OUT_DIR}" "${MPLCONFIGDIR}"

echo "[INFO] Host=$(hostname) Start=$(date)"
echo "[INFO] MODEL_DIR=${MODEL_DIR}"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] NUM_SAMPLES=${NUM_SAMPLES} BATCH_SIZE=${BATCH_SIZE} MAX_NEW=${MAX_NEW}"
echo "[INFO] SEEDS=${SEEDS}"
echo "[INFO] TEMPERATURES=${TEMPERATURES}"
echo "[INFO] TOP_PS=${TOP_PS}"
echo "[INFO] TOP_KS=${TOP_KS}"
nvidia-smi --query-gpu=name,memory.free --format=csv,noheader || true

python -u scripts/benchmark/sweep_denovo_pareto.py \
  --model-dir "${MODEL_DIR}" \
  --output-dir "${OUT_DIR}" \
  --num-samples "${NUM_SAMPLES}" \
  --batch-size "${BATCH_SIZE}" \
  --max-new "${MAX_NEW}" \
  --device cuda \
  --seeds "${SEEDS}" \
  --temperatures "${TEMPERATURES}" \
  --top-ps "${TOP_PS}" \
  --top-ks "${TOP_KS}" \
  2>&1 | tee "${OUT_DIR}/sweep.log"

echo "[INFO] End=$(date)"
