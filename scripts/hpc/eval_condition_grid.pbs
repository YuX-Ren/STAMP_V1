#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N eval_cond_grid
#PBS -l walltime=02:00:00
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb

set -euo pipefail

REPO_ROOT=/nfs/home/svu/yuxuan.ren/STAMP_V1.5
CONDA_ENV=stamp-train-rdkit-2025_09_4

: "${MODEL_DIR:=/scratch/yuxuan.ren/data/ckpt_stamp/zinc_stamp_nodecomp_aogpt_10m_qedsa_top12k_ddp2_small}"
: "${OUT_DIR:=${MODEL_DIR}/eval_condition_grid}"
: "${CONDITION_MODE:=qed_sa}"
: "${QED_BINS:=LOW,MID,HIGH,VHIGH}"
: "${SA_BINS:=LOW,MID,HIGH}"
: "${NUM_SAMPLES:=1024}"
: "${BATCH_SIZE:=128}"
: "${TEMP:=0.8}"
: "${TOPK:=0}"
: "${TOPP:=0.95}"
: "${MAX_NEW:=256}"
: "${DEDUP_FILL:=0}"
: "${OVERSAMPLE_FACTOR:=3.0}"
: "${SAVE_SMILES:=0}"

export OMP_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

source /scratch/yuxuan.ren/miniconda3/bin/activate "${CONDA_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
cd "${REPO_ROOT}"
mkdir -p "${OUT_DIR}"

echo "[INFO] Host=$(hostname) Start=$(date)"
echo "[INFO] MODEL_DIR=${MODEL_DIR}"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] CONDITION_MODE=${CONDITION_MODE} QED_BINS=${QED_BINS} SA_BINS=${SA_BINS}"
echo "[INFO] NUM_SAMPLES=${NUM_SAMPLES} BATCH_SIZE=${BATCH_SIZE} TEMP=${TEMP} TOPK=${TOPK} TOPP=${TOPP} MAX_NEW=${MAX_NEW}"
nvidia-smi --query-gpu=name,memory.free --format=csv,noheader || true

DEDUP_ARGS=()
if [[ "${DEDUP_FILL}" == "1" ]]; then
  DEDUP_ARGS=(--dedup-fill --oversample-factor "${OVERSAMPLE_FACTOR}")
fi

SAVE_SMILES_ARGS=()
if [[ "${SAVE_SMILES}" == "1" ]]; then
  SAVE_SMILES_ARGS=(--save-smiles)
fi

python -u scripts/benchmark/eval_condition_grid.py \
  --model-dir "${MODEL_DIR}" \
  --output-dir "${OUT_DIR}" \
  --condition-mode "${CONDITION_MODE}" \
  --qed-bins "${QED_BINS}" \
  --sa-bins "${SA_BINS}" \
  --num-samples "${NUM_SAMPLES}" \
  --batch-size "${BATCH_SIZE}" \
  --temperature "${TEMP}" \
  --top-k "${TOPK}" \
  --top-p "${TOPP}" \
  --max-new "${MAX_NEW}" \
  --device cuda \
  --seed 0 \
  "${DEDUP_ARGS[@]}" \
  "${SAVE_SMILES_ARGS[@]}" 2>&1 | tee "${OUT_DIR}/eval_condition_grid.log"

echo "[INFO] End=$(date)"
