#!/bin/bash
#PBS -P CFP03-CF-130
#PBS -j oe
#PBS -k oed
#PBS -N stamp_expc_eval_full
#PBS -l walltime=24:00:00
#PBS -l select=1:ngpus=1:ncpus=12

set -euo pipefail

source /scratch/yuxuan.ren/miniconda3/bin/activate

cd /home/svu/yuxuan.ren/STAMP

RUN_ROOT="${RUN_ROOT:-results/benchmark_20260403_193312}"
EVAL_WORKERS="${EVAL_WORKERS:-16}"
EVAL_CHUNKSIZE="${EVAL_CHUNKSIZE:-512}"

CSV_PATH="${RUN_ROOT}/expC_scaffold/train_scaffold.csv"
MODEL_DIR="${RUN_ROOT}/expC_scaffold/stamp_model"
OUT_DIR="${RUN_ROOT}/expC_scaffold/stamp_eval_full_t07_k1"

MAX_EVAL=$(( $(wc -l < "${CSV_PATH}") - 1 ))
if [[ "${MAX_EVAL}" -lt 0 ]]; then
  MAX_EVAL=0
fi

echo "[INFO] RUN_ROOT=${RUN_ROOT}"
echo "[INFO] CSV_PATH=${CSV_PATH}"
echo "[INFO] MODEL_DIR=${MODEL_DIR}"
echo "[INFO] OUT_DIR=${OUT_DIR}"
echo "[INFO] MAX_EVAL=${MAX_EVAL}"

time python scripts/experiments_cli.py eval-scaffold \
  --model-dir "${MODEL_DIR}" \
  --csv "${CSV_PATH}" \
  --output-dir "${OUT_DIR}" \
  --max-eval "${MAX_EVAL}" \
  --n-samples-per-prompt 1 \
  --max-new-tokens 256 \
  --temperature 0.7 \
  --top-k 1 \
  --eval-workers "${EVAL_WORKERS}" \
  --eval-chunksize "${EVAL_CHUNKSIZE}" \
  --device cuda

echo "[DONE] expC full eval complete: ${OUT_DIR}"
